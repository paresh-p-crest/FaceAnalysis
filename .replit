run = "bash artifacts/myface/start-prod.sh"
modules = ["bash", "nix", "nodejs-20", "postgresql-16", "python-3.11", "web"]

[deployment]
run = "bash artifacts/myface/start-prod.sh"
router = "application"
deploymentTarget = "gce"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Python Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir backend"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/myface: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/myface"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/myface run dev"
cwd = "./artifacts/myface"
waitForPort = 3000
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "3000"
BASE_PATH = "/"
NEXT_DISABLE_REACT_REFRESH = "1"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
ADMIN_EMAIL = "admin@myface.local"
CORS_ORIGINS = "http://localhost:3000,http://127.0.0.1:3000"
CORS_ORIGIN_REGEX = 'https://.*\.(replit\.dev|repl\.co)'
MEDIA_STORAGE_BACKEND = "replit"

[userenv.development]
PUBLIC_APP_URL = "https://3eb6e6db-88cf-4911-b87e-0ae0fd50ce81-00-ah0mxmpdefkb.pike.replit.dev"

[objectStorage]
defaultBucketID = "replit-objstore-88176689-d2b8-439d-bb1a-b81fab8693ef"
